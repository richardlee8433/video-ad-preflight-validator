{
  "profile": {"id": "iab-digital", "name": "IAB Digital Video", "market": "Global"},
  "rules": [
    {"id":"iab-container","destination":"iab","profile":"digital-ready-to-serve","market":"Global","attribute":"container","operator":"==","value":"mp4","severity":"error","source":"IAB Digital Video In-Stream Ad Format Guidelines","source_url":"https://www.iab.com/wp-content/uploads/2016/01/DVAFG_2015-01-08.pdf","version":"2016 publication","effective_date":"2016-01-01","unit":null,"explanation":"MP4 is the recommended cross-screen delivery container."},
    {"id":"iab-video-codec","destination":"iab","profile":"digital-ready-to-serve","market":"Global","attribute":"video_codec","operator":"==","value":"h264","severity":"error","source":"IAB Digital Video In-Stream Ad Format Guidelines","source_url":"https://www.iab.com/wp-content/uploads/2016/01/DVAFG_2015-01-08.pdf","version":"2016 publication","effective_date":"2016-01-01","unit":null,"explanation":"Ready-to-serve MP4 uses H.264 video for broad cross-screen compatibility."},
    {"id":"iab-resolution","destination":"iab","profile":"digital-ready-to-serve","market":"Global","attribute":"resolution","operator":"in","value":["1280x720","1920x1080"],"severity":"error","source":"IAB Digital Video In-Stream Ad Format Guidelines","source_url":"https://www.iab.com/wp-content/uploads/2016/01/DVAFG_2015-01-08.pdf","version":"2016 publication","effective_date":"2016-01-01","unit":"pixels","explanation":"This MVP baseline accepts the published 16:9 HD resolutions."},
    {"id":"iab-frame-rate","destination":"iab","profile":"digital-ready-to-serve","market":"Global","attribute":"frame_rate","operator":"approx","value":[25,0.02],"severity":"error","source":"IAB Digital Video In-Stream Ad Format Guidelines","source_url":"https://www.iab.com/wp-content/uploads/2016/01/DVAFG_2015-01-08.pdf","version":"2016 publication","effective_date":"2016-01-01","unit":"fps","explanation":"The selected PAL-context baseline uses the native 25 fps frame rate."},
    {"id":"iab-scan","destination":"iab","profile":"digital-ready-to-serve","market":"Global","attribute":"scan_type","operator":"==","value":"progressive","severity":"error","source":"IAB Digital Video In-Stream Ad Format Guidelines","source_url":"https://www.iab.com/wp-content/uploads/2016/01/DVAFG_2015-01-08.pdf","version":"2016 publication","effective_date":"2016-01-01","unit":null,"explanation":"Digital ready-to-serve video should use progressive scan."},
    {"id":"iab-audio-codec","destination":"iab","profile":"digital-ready-to-serve","market":"Global","attribute":"audio_codec","operator":"==","value":"aac","severity":"error","source":"IAB Digital Video In-Stream Ad Format Guidelines","source_url":"https://www.iab.com/wp-content/uploads/2016/01/DVAFG_2015-01-08.pdf","version":"2016 publication","effective_date":"2016-01-01","unit":null,"explanation":"AAC is the recommended audio format for ready-to-serve MP4."},
    {"id":"iab-audio-bitrate","destination":"iab","profile":"digital-ready-to-serve","market":"Global","attribute":"audio_bitrate","operator":"between","value":[128000,200000],"severity":"error","source":"IAB Digital Video In-Stream Ad Format Guidelines","source_url":"https://www.iab.com/wp-content/uploads/2016/01/DVAFG_2015-01-08.pdf","version":"2016 publication","effective_date":"2016-01-01","unit":"bps","explanation":"Nominal AAC-LC audio should be 128 to 192 kbps; a small encoder-reporting tolerance is allowed."},
    {"id":"iab-audio-sample-rate","destination":"iab","profile":"digital-ready-to-serve","market":"Global","attribute":"audio_sample_rate","operator":"in","value":[44100,48000],"severity":"error","source":"IAB Digital Video In-Stream Ad Format Guidelines","source_url":"https://www.iab.com/wp-content/uploads/2016/01/DVAFG_2015-01-08.pdf","version":"2016 publication","effective_date":"2016-01-01","unit":"Hz","explanation":"Audio should use 44.1 kHz or 48 kHz sample rate."},
    {"id":"iab-audio-channels","destination":"iab","profile":"digital-ready-to-serve","market":"Global","attribute":"audio_channels","operator":"==","value":2,"severity":"error","source":"IAB Digital Video In-Stream Ad Format Guidelines","source_url":"https://www.iab.com/wp-content/uploads/2016/01/DVAFG_2015-01-08.pdf","version":"2016 publication","effective_date":"2016-01-01","unit":"channels","explanation":"A two-channel stereo mix is expected."}
  ]
